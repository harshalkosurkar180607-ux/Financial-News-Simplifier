# FinNews AI - Environment Variables Configuration

# Groq API Key for LLaMA 3.3 70B Versatile inference
# Get a free API key at: https://console.groq.com/keys
GROQ_API_KEY=

# NewsAPI Key for real-time financial news retrieval
# Get a free API key at: https://newsapi.org/register
NEWS_API_KEY=

# AI Model Configuration
GROQ_MODEL=llama-3.3-70b-versatile

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./finnews.db
